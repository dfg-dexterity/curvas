# Conexão Postgres (local: docker compose up -d)
# Em produção use Supabase/Neon/RDS etc. Com Supabase, prefira a connection
# string do pooler em modo transação (porta 6543).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/curvas?schema=public"

# Segredo exigido pelas rotas /api/cron/* (o Vercel Cron envia
# "Authorization: Bearer $CRON_SECRET" automaticamente quando definido).
CRON_SECRET="troque-este-valor"

# Opcional: sobrescreve a URL base da API de Taxas Referenciais da B3.
# B3_PROXY_URL="https://sistemaswebb3-derivativos.b3.com.br/referenceRatesProxy/"

# Opcional: quantas requisições simultâneas à B3 (padrão 4).
# B3_FETCH_CONCURRENCY=4

# Opcional: quantos dias úteis para trás o job diário verifica/completa (padrão 5).
# JOB_CATCHUP_BDAYS=5
